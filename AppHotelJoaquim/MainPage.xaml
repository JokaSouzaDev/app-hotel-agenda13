<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppHotelJoaquim.MainPage"
             Title="Reservar"
             BackgroundColor="{StaticResource Fundo}">
    <ScrollView>
        <VerticalStackLayout Padding="22,22,22,40" Spacing="17" MaximumWidthRequest="650">

            <Border Stroke="#DCE5ED" StrokeThickness="1" BackgroundColor="White" Padding="16"
                    StrokeShape="RoundRectangle 20">
                <Grid ColumnDefinitions="90,*" ColumnSpacing="15">
                    <Image Grid.Column="0" Source="hotel.png" HeightRequest="90" WidthRequest="90"
                           Aspect="AspectFit" SemanticProperties.Description="Ilustração do Hotel Aurora" />
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                        <Label Text="HOTEL AURORA" TextColor="{StaticResource Dourado}"
                               FontAttributes="Bold" FontSize="12" CharacterSpacing="2" />
                        <Label Text="Sua estadia começa aqui" FontSize="22"
                               FontAttributes="Bold" TextColor="{StaticResource AzulEscuro}" />
                        <Label Text="Simule uma reserva em poucos passos."
                               FontSize="12" TextColor="{StaticResource CinzaTexto}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Label Text="Cálculo da diária" FontSize="25" FontAttributes="Bold"
                   TextColor="{StaticResource AzulEscuro}" />
            <Label Text="Escolha seus hóspedes, acomodação e período da viagem."
                   FontSize="14" TextColor="{StaticResource CinzaTexto}" />

            <Border Stroke="#DCE5ED" BackgroundColor="White" Padding="18" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="15">
                    <Label Text="01  HÓSPEDES" FontSize="13" FontAttributes="Bold"
                           TextColor="{StaticResource Dourado}" />
                    <Grid ColumnDefinitions="*,Auto,155" RowDefinitions="Auto,Auto"
                          RowSpacing="16" ColumnSpacing="12">
                        <Label Grid.Row="0" Grid.Column="0" Text="Adultos" VerticalOptions="Center"
                               TextColor="{StaticResource AzulEscuro}" />
                        <Label Grid.Row="0" Grid.Column="1" VerticalOptions="Center"
                               FontSize="20" FontAttributes="Bold" TextColor="{StaticResource AzulEscuro}"
                               BindingContext="{x:Reference stpAdultos}"
                               Text="{Binding Value, StringFormat='{0:0}'}" />
                        <Stepper Grid.Row="0" Grid.Column="2" x:Name="stpAdultos"
                                 Minimum="0" Maximum="10" Increment="1" Value="2" />

                        <Label Grid.Row="1" Grid.Column="0" Text="Crianças" VerticalOptions="Center"
                               TextColor="{StaticResource AzulEscuro}" />
                        <Label Grid.Row="1" Grid.Column="1" VerticalOptions="Center"
                               FontSize="20" FontAttributes="Bold" TextColor="{StaticResource AzulEscuro}"
                               BindingContext="{x:Reference stpCriancas}"
                               Text="{Binding Value, StringFormat='{0:0}'}" />
                        <Stepper Grid.Row="1" Grid.Column="2" x:Name="stpCriancas"
                                 Minimum="0" Maximum="10" Increment="1" Value="0" />
                    </Grid>
                    <Label Text="Os números mudam automaticamente por BindingContext."
                           FontSize="12" TextColor="{StaticResource CinzaTexto}" />
                </VerticalStackLayout>
            </Border>

            <Border Stroke="#DCE5ED" BackgroundColor="White" Padding="18" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="10">
                    <Label Text="02  ACOMODAÇÃO" FontSize="13" FontAttributes="Bold"
                           TextColor="{StaticResource Dourado}" />
                    <Label Text="Escolha sua suíte" FontSize="16"
                           TextColor="{StaticResource AzulEscuro}" />
                    <Picker x:Name="pckQuarto" Title="Selecione a acomodação"
                            TextColor="{StaticResource AzulEscuro}" TitleColor="{StaticResource CinzaTexto}">
                        <Picker.Items>
                            <x:String>Suíte Standard · R$ 220/noite</x:String>
                            <x:String>Suíte Luxo · R$ 350/noite</x:String>
                            <x:String>Suíte Premium · R$ 490/noite</x:String>
                        </Picker.Items>
                    </Picker>
                </VerticalStackLayout>
            </Border>

            <Border Stroke="#DCE5ED" BackgroundColor="White" Padding="18" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="12">
                    <Label Text="03  PERÍODO DA ESTADIA" FontSize="13" FontAttributes="Bold"
                           TextColor="{StaticResource Dourado}" />
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" ColumnSpacing="12" RowSpacing="8">
                        <Label Grid.Row="0" Grid.Column="0" Text="Check-in" FontSize="14"
                               TextColor="{StaticResource AzulEscuro}" />
                        <Label Grid.Row="0" Grid.Column="1" Text="Check-out" FontSize="14"
                               TextColor="{StaticResource AzulEscuro}" />
                        <DatePicker Grid.Row="1" Grid.Column="0" x:Name="dtpCheckin"
                                    Format="dd/MM/yyyy" DateSelected="OnCheckinChanged"
                                    TextColor="{StaticResource AzulEscuro}" />
                        <DatePicker Grid.Row="1" Grid.Column="1" x:Name="dtpCheckout"
                                    Format="dd/MM/yyyy" TextColor="{StaticResource AzulEscuro}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Button Text="Calcular reserva" Clicked="OnCalcularClicked"
                    FontSize="17" FontAttributes="Bold" BackgroundColor="{StaticResource AzulEscuro}"
                    TextColor="White" CornerRadius="14" HeightRequest="54" />
            <Label Text="Atividade educacional: preços ilustrativos, nenhuma reserva real será realizada."
                   FontSize="12" HorizontalTextAlignment="Center"
                   TextColor="{StaticResource CinzaTexto}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
