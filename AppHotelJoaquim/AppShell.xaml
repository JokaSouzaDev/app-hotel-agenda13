<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:AppHotelJoaquim"
       xmlns:views="clr-namespace:AppHotelJoaquim.Views"
       x:Class="AppHotelJoaquim.AppShell"
       Title="Hotel Aurora"
       Shell.BackgroundColor="#10253F"
       Shell.ForegroundColor="White"
       Shell.TitleColor="White"
       Shell.UnselectedColor="#B8C3D0"
       Shell.TabBarBackgroundColor="#10253F"
       Shell.TabBarForegroundColor="#E8C58E"
       Shell.TabBarUnselectedColor="#B8C3D0">
    <TabBar>
        <ShellContent Title="Reservar"
                      ContentTemplate="{DataTemplate local:MainPage}"
                      Route="reserva" />
        <ShellContent Title="Sobre"
                      ContentTemplate="{DataTemplate views:SobrePage}"
                      Route="sobre" />
    </TabBar>
</Shell>
